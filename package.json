{
  "name": "lernquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Roguelike-Lernspiel für Grundschüler (Klasse 1 bis 3): Mathe, Deutsch, Englisch, Ethik und Sachkunde. Eine HTML-Datei, kein Server.",
  "scripts": {
    "build": "node tools/build.js",
    "test": "node --test --test-reporter=spec \"tests/test_*.js\"",
    "playtest": "node tools/build.js && node --test --test-reporter=spec tests/playtests.js",
    "e2e": "node --test --test-reporter=spec tests/e2e.js",
    "screenshots": "node tools/screenshots.js",
    "format": "biome format --write .",
    "lint": "biome lint . && stylelint \"src/styles/*.css\"",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.0",
    "playwright": "1.65.0",
    "stylelint": "18.0.0",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
