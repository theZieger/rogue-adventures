{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!art", "!docs", "!lehrplan", "!package-lock.json", "!**/*.md"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": { "enabled": false },
  "linter": {
    "rules": { "preset": "none", "correctness": { "noUndeclaredVariables": "error" } }
  }
}
